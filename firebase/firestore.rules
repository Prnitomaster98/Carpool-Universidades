rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funciones de ayuda ----------
    // Van aquí arriba, FUERA de cualquier "match /coleccion", para que todas las colecciones las puedan usar.

    // ¿Hay sesión y el correo es de un dominio permitido?
    // [.] significa "un punto de verdad" (en regex, un punto solo significa "cualquier letra")
    function correoPermitido() {
      return request.auth != null
        && (request.auth.token.email.matches('.*@uvg[.]edu[.]gt$')
            || request.auth.token.email.matches('.*@suizoamericano[.]edu[.]gt$')
            || request.auth.token.email.matches('.*@gmail[.]com$'));  // QUITAR ANTES DE LA DEMO
    }

    // ¿Es un número de Guatemala de 8 dígitos?
    function telefonoValido(t) {
      return t is string && t.matches('^[0-9]{8}$');
    }

    // ¿Además verificó su correo?
    function verificado() {
      return correoPermitido() && request.auth.token.email_verified == true;
    }

    // ¿El documento solo trae campos de nuestra lista?
    function soloCamposPermitidos() {
      return request.resource.data.keys().hasOnly(
        ['uid', 'nombre', 'carrera', 'rol', 'zonas', 'horario', 'tolerancia', 'esDemo']);
    }

    // ¿Los campos del perfil (Fase 4) tienen valores válidos?
    // "!('rol' in d) ||" = si el campo no viene, no hay nada que revisar.
    function perfilValido() {
      let d = request.resource.data;
      return (!('rol' in d) || d.rol in ['conductor', 'pasajero', 'ambos'])
        && (!('zonas' in d) || (d.zonas is list && d.zonas.size() <= 10))
        && (!('horario' in d) || (d.horario is map
              && d.horario.keys().hasOnly(['lunes', 'martes', 'miercoles', 'jueves', 'viernes'])))
        && (!('tolerancia' in d) || d.tolerancia in [10, 20, 30]);
    }

    // ¿El viaje (Fase 5) tiene solo nuestros campos y valores válidos?
    function viajeValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['conductorUid', 'conductorNombre', 'zonaId', 'puntoId',
                               'dia', 'tramo', 'hora', 'cupos', 'creado', 'esDemo'])
        && d.conductorUid == request.auth.uid
        && d.conductorNombre is string && d.conductorNombre.size() <= 60
        && d.zonaId is string && d.zonaId.size() <= 40
        && d.puntoId is string && d.puntoId.size() <= 60
        && d.dia in ['lunes', 'martes', 'miercoles', 'jueves', 'viernes']
        && d.tramo in ['ida', 'regreso']
        && d.hora is string && d.hora.matches('^[0-2][0-9]:[0-5][0-9]$')
        && d.cupos is int && d.cupos >= 1 && d.cupos <= 4
        && d.creado == request.time
        && d.esDemo == false;
    }

    // ¿La solicitud (Fase 5) es válida?
    // get(...) lee el viaje para comprobar que el conductor sea el de verdad.
    function solicitudValida(solicitudId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['viajeId', 'conductorUid', 'conductorNombre', 'pasajeroUid',
                               'pasajeroNombre', 'dia', 'tramo', 'hora', 'puntoId',
                               'estado', 'creado', 'esDemo', 'pasajeroTelefono'])
        && solicitudId == d.viajeId + '_' + request.auth.uid
        && d.pasajeroUid == request.auth.uid
        && d.conductorUid != request.auth.uid
        && d.conductorUid == get(/databases/$(database)/documents/viajes/$(d.viajeId)).data.conductorUid
        && d.pasajeroNombre is string && d.pasajeroNombre.size() <= 60
        && d.conductorNombre is string && d.conductorNombre.size() <= 60
        && (!('pasajeroTelefono' in d) || telefonoValido(d.pasajeroTelefono))
        && d.estado == 'pendiente'
        && d.creado == request.time
        && d.esDemo == false;
    }

    // ---------- Colección usuarios ----------
    match /usuarios/{uid} {

      // Leer perfiles: solo estudiantes verificados (para el matching)
      allow read: if verificado();

      // Crear: al registrarse (aún sin verificar), SOLO su propio documento
      allow create: if correoPermitido()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'nombre', 'carrera', 'esDemo'])
        && request.resource.data.uid == uid
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() <= 60
        && request.resource.data.carrera is string
        && request.resource.data.carrera.size() <= 60
        && request.resource.data.esDemo == false;

      // Modificar: solo el dueño, verificado, sin campos extra, sin cambiar uid ni esDemo
      allow update: if verificado()
        && request.auth.uid == uid
        && soloCamposPermitidos()
        && perfilValido()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.esDemo == false;

      // Borrar: nadie desde la app
      allow delete: if false;
    }

    // ---------- Colección viajes (Fase 5) ----------
    match /viajes/{viajeId} {
      // Ver viajes: cualquier estudiante verificado
      allow read: if verificado();

      // Publicar: solo a tu nombre y con datos válidos
      allow create: if verificado() && viajeValido();

      // Editar: nadie (si te equivocas, lo borras y publicas otro)
      allow update: if false;

      // Borrar: solo el conductor que lo publicó
      allow delete: if verificado() && resource.data.conductorUid == request.auth.uid;
    }

    // ---------- Colección solicitudes (Fase 5) ----------
    match /solicitudes/{solicitudId} {
      // Leer: solo el pasajero que la mandó o el conductor que la recibió
      allow read: if verificado()
        && (resource.data.pasajeroUid == request.auth.uid
            || resource.data.conductorUid == request.auth.uid);

      // Crear: el pasajero, para sí mismo, siempre "pendiente"
      allow create: if verificado() && solicitudValida(solicitudId);

      // Responder: solo el conductor, y SOLO puede cambiar "estado"
      allow update: if verificado()
        && resource.data.conductorUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'conductorTelefono'])
        && request.resource.data.estado in ['aceptada', 'rechazada']
        && (!('conductorTelefono' in request.resource.data)
            || telefonoValido(request.resource.data.conductorTelefono));

      // Cancelar: solo el pasajero que la mandó
      allow delete: if verificado() && resource.data.pasajeroUid == request.auth.uid;
    }

    // ---------- Colección contactos (tu WhatsApp, privado) ----------
    match /contactos/{uid} {
      allow read: if verificado() && request.auth.uid == uid;
      allow create, update: if verificado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['telefono'])
        && telefonoValido(request.resource.data.telefono);
      allow delete: if false;
    }

    // Cualquier otra colección: cerrada hasta que escribamos sus reglas
  }
}